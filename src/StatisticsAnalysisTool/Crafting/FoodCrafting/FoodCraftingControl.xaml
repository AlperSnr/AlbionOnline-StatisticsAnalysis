<!-- [FORK] Food crafting feature. Fork-only file. -->
<UserControl x:Class="StatisticsAnalysisTool.Crafting.FoodCrafting.FoodCraftingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:food="clr-namespace:StatisticsAnalysisTool.Crafting.FoodCrafting"
             mc:Ignorable="d"
             d:DesignHeight="1000"
             d:DesignWidth="1300"
             d:DataContext="{d:DesignInstance Type=food:FoodCraftingBindings}"
             Loaded="FoodCraftingControl_OnLoaded"
             Unloaded="FoodCraftingControl_OnUnloaded">
    <UserControl.Resources>
        <Style x:Key="Food.SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Blue.2}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Food.Field" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Margin" Value="0,0,12,8" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="Food.Label" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.2}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="Food.Input" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Food.Tile" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SolidColorBrush.Background.2}" />
            <Setter Property="BorderBrush" Value="{StaticResource SolidColorBrush.Background.4}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinWidth" Value="130" />
        </Style>
        <Style x:Key="Food.TileLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.4}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Food.TileValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Food.RightCell" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource SolidColorBrush.Text.1}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- Settings -->
            <Border Style="{StaticResource App.TopFilterCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Food crafting settings" Style="{StaticResource Food.SectionTitle}" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource Food.Field}">
                            <TextBlock Text="City (buy + craft + sell)" Style="{StaticResource Food.Label}" />
                            <ComboBox ItemsSource="{Binding CityOptions}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectedValue="{Binding Settings.City, Mode=TwoWay}" MinWidth="140" Height="26" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}">
                            <TextBlock Text="Daily bonus %" Style="{StaticResource Food.Label}" />
                            <ComboBox ItemsSource="{Binding DailyBonusOptions}"
                                      SelectedItem="{Binding Settings.DailyBonusPercent, Mode=TwoWay}" Height="26" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}"
                                    ToolTip="Station usage fee in silver per 100 nutrition (shown at the cooking station).">
                            <TextBlock Text="Station fee / 100 nutrition" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.StationFeePerHundredNutrition, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}" ToolTip="4% with premium, 8% without.">
                            <TextBlock Text="Sales tax %" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.SalesTaxPercent, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}">
                            <TextBlock Text="Setup fee %" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.SetupFeePercent, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}" ToolTip="Prices older than this are ignored. 0 = no limit.">
                            <TextBlock Text="Max price age (hours)" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.MaxPriceAgeHours, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}"
                                    ToolTip="Use the sell orders the game sent while you opened items in the market (Buy tab). Buying more than the cheapest order pushes the price up; this is included.">
                            <TextBlock Text="In-game sell orders" Style="{StaticResource Food.Label}" />
                            <CheckBox Content="Use for real cost" IsChecked="{Binding Settings.UseOrderBooks, Mode=TwoWay}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}"
                                    ToolTip="Returns are random. With few crafts you can get less back than expected and run out. Buys this many standard deviations extra (0 = none, 1 ≈ 84%, 2 ≈ 98% enough). Never more than the no-return quantity.">
                            <TextBlock Text="Safety margin (σ)" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.ShoppingSafetyMargin, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}" ToolTip="Captured sell orders older than this are ignored. 0 = no limit.">
                            <TextBlock Text="Max order age (min)" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.OrderBookMaxAgeMinutes, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}">
                            <TextBlock Text="Enchantments" Style="{StaticResource Food.Label}" />
                            <StackPanel Orientation="Horizontal" Height="26">
                                <CheckBox Content=".0" IsChecked="{Binding Settings.IncludeEnchantment0, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <CheckBox Content=".1" IsChecked="{Binding Settings.IncludeEnchantment1, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <CheckBox Content=".2" IsChecked="{Binding Settings.IncludeEnchantment2, Mode=TwoWay}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <CheckBox Content=".3" IsChecked="{Binding Settings.IncludeEnchantment3, Mode=TwoWay}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>

                    <TextBlock Text="Daily focus planner" Style="{StaticResource Food.SectionTitle}" Margin="0,6,0,8" />
                    <WrapPanel>
                        <StackPanel Style="{StaticResource Food.Field}" ToolTip="Focus to spend (premium gives 10,000 per day).">
                            <TextBlock Text="Focus budget" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.FocusBudget, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}" ToolTip="Max silver to spend on one plan (expected material cost + station fee). 0 = no limit.">
                            <TextBlock Text="Max investment" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.MaxInvestment, Mode=TwoWay, StringFormat=N0}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}" ToolTip="Craft at most (items sold per day ÷ this value) of each food.">
                            <TextBlock Text="Daily volume divisor" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.DailyVolumeDivisor, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}" ToolTip="Average daily sales are taken from this many past days.">
                            <TextBlock Text="Volume days" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.VolumeDays, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Food.Field}">
                            <TextBlock Text="Min. profit per focus" Style="{StaticResource Food.Label}" />
                            <TextBox Text="{Binding Settings.MinProfitPerFocus, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Destiny board + fish sauce -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource App.FilterCard}">
                    <StackPanel>
                        <TextBlock Text="Destiny board (cooking)" Style="{StaticResource Food.SectionTitle}" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource Food.Field}">
                                <TextBlock Text="Mastery level" Style="{StaticResource Food.Label}" />
                                <TextBox Text="{Binding Settings.DestinyBoard.MasteryLevel, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Settings.DestinyBoard.Specializations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type food:FoodSpecializationLevel}">
                                        <StackPanel Style="{StaticResource Food.Field}" MinWidth="90">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Food.Label}" />
                                            <TextBox Text="{Binding Level, Mode=TwoWay}" Style="{StaticResource Food.Input}" MinWidth="70" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <Expander Header="Focus formula (advanced / check)" Foreground="{StaticResource SolidColorBrush.Text.2}" Margin="0,4,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Foreground="{StaticResource SolidColorBrush.Text.3}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Focus = base focus × 0.5^(FCE ÷ 10,000). FCE = mastery × A + every specialization × C + the food's own specialization × B (own spec = B + C = 280 per level). Defaults verified in-game." />
                                <WrapPanel>
                                    <StackPanel Style="{StaticResource Food.Field}">
                                        <TextBlock Text="A: FCE per mastery level" Style="{StaticResource Food.Label}" />
                                        <TextBox Text="{Binding Settings.DestinyBoard.FcePerMasteryLevel, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Food.Field}">
                                        <TextBlock Text="B: extra FCE per own spec level" Style="{StaticResource Food.Label}" />
                                        <TextBox Text="{Binding Settings.DestinyBoard.FceExtraPerOwnSpecializationLevel, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Food.Field}">
                                        <TextBlock Text="C: FCE per any spec level" Style="{StaticResource Food.Label}" />
                                        <TextBox Text="{Binding Settings.DestinyBoard.FcePerOtherSpecializationLevel, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                                    </StackPanel>
                                </WrapPanel>
                                <WrapPanel>
                                    <StackPanel Style="{StaticResource Food.Field}">
                                        <TextBlock Text="Food" Style="{StaticResource Food.Label}" />
                                        <ComboBox ItemsSource="{Binding FoodItemOptions}" DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding CalibrationItem, Mode=TwoWay}" MinWidth="260" Height="26" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Food.Field}">
                                        <TextBlock Text="In-game focus cost" Style="{StaticResource Food.Label}" />
                                        <TextBox Text="{Binding CalibrationInGameFocus, Mode=TwoWay}" Style="{StaticResource Food.Input}" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource Food.Field}">
                                        <TextBlock Text=" " Style="{StaticResource Food.Label}" />
                                        <Button Content="Compare" Height="26" Width="90" Command="{Binding UpdateCalibrationCommand}" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding CalibrationResultText}" Foreground="{StaticResource SolidColorBrush.Text.1}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource App.FilterCard}" MinWidth="420">
                    <StackPanel>
                        <TextBlock Text="Fish sauce" Style="{StaticResource Food.SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sauce .1 (for .1 food)" Style="{StaticResource Food.Label}" VerticalAlignment="Center" Margin="0,0,10,6" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FishSauceModeOptions}" SelectedItem="{Binding FishSauceLevel1Mode, Mode=TwoWay}" Height="26" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sauce .2 (for .2 food)" Style="{StaticResource Food.Label}" VerticalAlignment="Center" Margin="0,0,10,6" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FishSauceModeOptions}" SelectedItem="{Binding FishSauceLevel2Mode, Mode=TwoWay}" Height="26" Margin="0,0,0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sauce .3 (for .3 food)" Style="{StaticResource Food.Label}" VerticalAlignment="Center" Margin="0,0,10,6" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding FishSauceModeOptions}" SelectedItem="{Binding FishSauceLevel3Mode, Mode=TwoWay}" Height="26" Margin="0,0,0,6" />
                        </Grid>
                        <ListView ItemsSource="{Binding FishSauceRows}" Margin="0,4,0,0" MinHeight="60">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Icon}" Width="28" Height="28" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Sauce" Width="120" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Market" Width="80" DisplayMemberBinding="{Binding MarketPriceText}" />
                                    <GridViewColumn Header="Crafted" Width="80" DisplayMemberBinding="{Binding CraftedCostText}" />
                                    <GridViewColumn Header="Used" Width="110" DisplayMemberBinding="{Binding UsedText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Text="Cheapest = craft when crafting costs less than buying." Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Load prices &amp; plan" Width="150" Height="28" Command="{Binding LoadAndPlanCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Content="Recalculate" Width="110" Height="28" Margin="6,0,0,0" Command="{Binding RecalculateCommand}" IsEnabled="{Binding IsIdle}"
                        ToolTip="Use the downloaded prices again after changing settings (no download)." />
                <Button Content="Cancel" Width="80" Height="28" Margin="6,0,0,0" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"
                        Style="{StaticResource Style.Button.Neutral}" />
                <ToggleButton Width="110" Height="28" Margin="12,0,0,0" IsChecked="{Binding IsPlanLocked, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                              ToolTip="Lock: keep exactly these foods and crafts (also after restart). Prices and the shopping list still update. Unlock to plan again.">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource App.FilterToggleButton}">
                            <Setter Property="Content" Value="🔓 Lock plan" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="🔒 Locked" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SolidColorBrush.Text.2}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="900" />
            </StackPanel>
            <TextBlock Text="{Binding ReturnRateText}" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,2" />
            <TextBlock Text="{Binding OrderBookCaptureText}" Foreground="{StaticResource SolidColorBrush.Text.3}" Margin="0,0,0,8" />

            <!-- Missing / outdated prices -->
            <Expander Margin="0,0,0,10" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="{Binding MissingPriceSummaryText}" Foreground="{StaticResource SolidColorBrush.Accent.Yellow.2}" FontWeight="SemiBold" />
                </Expander.Header>
                <StackPanel Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Open these items in the in-game market with the Albion Data Client running, then press &quot;Load prices &amp; plan&quot; again."
                                   Foreground="{StaticResource SolidColorBrush.Text.3}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" />
                        <Button Content="Copy list" Width="90" Height="24" Margin="10,0,0,0" Command="{Binding CopyMissingPricesCommand}"
                                Style="{StaticResource Style.Button.Neutral}" ToolTip="Copy item names, status and blocked food count to the clipboard." />
                    </StackPanel>
                    <ListView ItemsSource="{Binding MissingPriceRows}" MinHeight="60" MaxHeight="360">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="45">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Icon}" Width="32" Height="32" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Item" Width="230" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Tier" Width="55" DisplayMemberBinding="{Binding TierText}" />
                                <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding UsageText}" />
                                <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Item.StatusText}" />
                                <GridViewColumn Header="Last price" Width="85" DisplayMemberBinding="{Binding LastPriceText}" />
                                <GridViewColumn Header="Blocks" Width="60" DisplayMemberBinding="{Binding Item.BlockedFoodCount}" />
                                <GridViewColumn Header="Blocked foods" Width="420">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BlockedFoodsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BlockedFoodsText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Expander>

            <!-- Plan summary -->
            <TextBlock Text="Today's plan" Style="{StaticResource Food.SectionTitle}" />
            <WrapPanel Margin="0,0,0,6">
                <Border Style="{StaticResource Food.Tile}">
                    <StackPanel>
                        <TextBlock Text="Focus used" Style="{StaticResource Food.TileLabel}" />
                        <TextBlock Text="{Binding Plan.TotalFocus, StringFormat=N0, FallbackValue=0}" Style="{StaticResource Food.TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Food.Tile}">
                    <StackPanel>
                        <TextBlock Text="Focus left" Style="{StaticResource Food.TileLabel}" />
                        <TextBlock Text="{Binding Plan.RemainingFocus, StringFormat=N0, FallbackValue=0}" Style="{StaticResource Food.TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Food.Tile}">
                    <StackPanel>
                        <TextBlock Text="Investment" Style="{StaticResource Food.TileLabel}" />
                        <TextBlock Text="{Binding Plan.TotalInvestment, StringFormat=N0, FallbackValue=0}" Style="{StaticResource Food.TileValue}"
                                   Foreground="{StaticResource SolidColorBrush.Accent.Red.2}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Food.Tile}">
                    <StackPanel>
                        <TextBlock Text="Revenue (net)" Style="{StaticResource Food.TileLabel}" />
                        <TextBlock Text="{Binding Plan.TotalRevenue, StringFormat=N0, FallbackValue=0}" Style="{StaticResource Food.TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Food.Tile}">
                    <StackPanel>
                        <TextBlock Text="Profit" Style="{StaticResource Food.TileLabel}" />
                        <TextBlock Text="{Binding Plan.TotalProfit, StringFormat=N0, FallbackValue=0}" Style="{StaticResource Food.TileValue}"
                                   Foreground="{StaticResource SolidColorBrush.Accent.Green.2}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Food.Tile}">
                    <StackPanel>
                        <TextBlock Text="Profit / focus" Style="{StaticResource Food.TileLabel}" />
                        <TextBlock Text="{Binding Plan.ProfitPerFocus, StringFormat=N1, FallbackValue=0}" Style="{StaticResource Food.TileValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Food.Tile}">
                    <StackPanel>
                        <TextBlock Text="Items" Style="{StaticResource Food.TileLabel}" />
                        <TextBlock Text="{Binding Plan.TotalItems, StringFormat=N0, FallbackValue=0}" Style="{StaticResource Food.TileValue}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <ListView ItemsSource="{Binding PlanRows}" MinHeight="80" Margin="0,0,0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="32" Height="32" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Food" Width="230" DisplayMemberBinding="{Binding Entry.Candidate.Name}" />
                        <GridViewColumn Header="Tier" Width="55" DisplayMemberBinding="{Binding Entry.Candidate.TierText}" />
                        <GridViewColumn Header="Crafts" Width="65" DisplayMemberBinding="{Binding Entry.Crafts}" />
                        <GridViewColumn Header="Items" Width="65" DisplayMemberBinding="{Binding Entry.Items}" />
                        <GridViewColumn Header="Max crafts" Width="80" DisplayMemberBinding="{Binding Entry.MaxCrafts}" />
                        <GridViewColumn Header="Focus" Width="80" DisplayMemberBinding="{Binding Entry.Focus, StringFormat=N0}" />
                        <GridViewColumn Header="Investment" Width="100" DisplayMemberBinding="{Binding Entry.Investment, StringFormat=N0}" />
                        <GridViewColumn Header="Profit" Width="100" DisplayMemberBinding="{Binding Entry.Profit, StringFormat=N0}" />
                        <GridViewColumn Header="Profit / focus" Width="95" DisplayMemberBinding="{Binding Entry.Candidate.ProfitPerFocus, StringFormat=N1}" />
                        <GridViewColumn Header="Sell price" Width="90" DisplayMemberBinding="{Binding Entry.Candidate.SellPrice, StringFormat=N0}" />
                        <GridViewColumn Header="Sold / day" Width="80" DisplayMemberBinding="{Binding Entry.Candidate.DailyVolume, StringFormat=N1}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Shopping list -->
            <TextBlock Text="Shopping list" Style="{StaticResource Food.SectionTitle}" />
            <TextBlock Text="{Binding OrderBookSummaryText}" Foreground="{StaticResource SolidColorBrush.Text.2}" Margin="0,0,0,4" TextWrapping="Wrap" />
            <ListView ItemsSource="{Binding ShoppingRows}" MinHeight="80" Margin="0,0,0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="32" Height="32" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Item" Width="230" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="For" Width="85" DisplayMemberBinding="{Binding UsageText}" />
                        <GridViewColumn Header="Buy (safe)" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Item.SafeQuantityToBuy, StringFormat=N0}" FontWeight="Bold"
                                               ToolTip="{Binding Item.SafetyExtra, StringFormat='Expected + {0:N0} extra against bad luck with returns'}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Buy (expected)" Width="110" DisplayMemberBinding="{Binding Item.NetQuantityToBuy, StringFormat=N0}" />
                        <GridViewColumn Header="Buy (no returns)" Width="120" DisplayMemberBinding="{Binding Item.GrossQuantityToBuy, StringFormat=N0}" />
                        <GridViewColumn Header="Unit price" Width="90" DisplayMemberBinding="{Binding Item.UnitPrice, StringFormat=N0}" />
                        <GridViewColumn Header="Cost (expected)" Width="120" DisplayMemberBinding="{Binding Item.NetCost, StringFormat=N0}" />
                        <GridViewColumn Header="Listed" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="ListedText" Text="{Binding ListedText}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsShort}" Value="True">
                                            <Setter TargetName="ListedText" Property="Foreground" Value="{StaticResource SolidColorBrush.Accent.Red.2}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Real avg price" Width="130" DisplayMemberBinding="{Binding RealUnitPriceText}" />
                        <GridViewColumn Header="Real cost" Width="110" DisplayMemberBinding="{Binding RealCostText}" />
                        <GridViewColumn Header="Orders seen" Width="100" DisplayMemberBinding="{Binding BookAgeText}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Fish sauce to craft -->
            <TextBlock Text="Fish sauce to craft" Style="{StaticResource Food.SectionTitle}" />
            <TextBlock Text="{Binding FishSauceCraftSummaryText}" Foreground="{StaticResource SolidColorBrush.Text.2}" Margin="0,0,0,4" TextWrapping="Wrap" />
            <ListView ItemsSource="{Binding FishSauceCraftRows}" MinHeight="60" Margin="0,0,0,10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="32" Height="32" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Sauce" Width="200" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Sauces to craft" Width="115">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Craft.SaucesCrafted, StringFormat=N0}" FontWeight="Bold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Crafts" Width="70" DisplayMemberBinding="{Binding Craft.Crafts, StringFormat=N0}" />
                        <GridViewColumn Header="Chopped Fish" Width="105" DisplayMemberBinding="{Binding ChoppedFish, StringFormat=N0}" />
                        <GridViewColumn Header="Seaweed" Width="85" DisplayMemberBinding="{Binding Seaweed, StringFormat=N0}" />
                        <GridViewColumn Header="Used (expected)" Width="115" DisplayMemberBinding="{Binding Craft.NetSauces, StringFormat=N0}" />
                        <GridViewColumn Header="Used (no returns)" Width="125" DisplayMemberBinding="{Binding Craft.GrossSauces, StringFormat=N0}" />
                        <GridViewColumn Header="Recipe" Width="260" DisplayMemberBinding="{Binding IngredientsText}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- All profitable foods -->
            <TextBlock Text="All profitable foods (best profit per focus first)" Style="{StaticResource Food.SectionTitle}" />
            <ListView ItemsSource="{Binding Candidates}" MinHeight="120">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="32" Height="32" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Food" Width="230" DisplayMemberBinding="{Binding Candidate.Name}" />
                        <GridViewColumn Header="Tier" Width="55" DisplayMemberBinding="{Binding Candidate.TierText}" />
                        <GridViewColumn Header="Category" Width="90" DisplayMemberBinding="{Binding CategoryText}" />
                        <GridViewColumn Header="Per craft" Width="70" DisplayMemberBinding="{Binding Candidate.AmountCrafted}" />
                        <GridViewColumn Header="Base focus" Width="80" DisplayMemberBinding="{Binding Candidate.BaseFocusPerCraft, StringFormat=N0}" />
                        <GridViewColumn Header="Focus / craft" Width="90" DisplayMemberBinding="{Binding Candidate.FocusPerCraft, StringFormat=N1}" />
                        <GridViewColumn Header="Focus / item" Width="85" DisplayMemberBinding="{Binding Candidate.FocusPerItem, StringFormat=N1}" />
                        <GridViewColumn Header="Sell price" Width="85" DisplayMemberBinding="{Binding Candidate.SellPrice, StringFormat=N0}" />
                        <GridViewColumn Header="Cost / item" Width="85" DisplayMemberBinding="{Binding Candidate.CostPerItem, StringFormat=N0}" />
                        <GridViewColumn Header="Profit / item" Width="90" DisplayMemberBinding="{Binding Candidate.ProfitPerItem, StringFormat=N0}" />
                        <GridViewColumn Header="Profit / focus" Width="95" DisplayMemberBinding="{Binding Candidate.ProfitPerFocus, StringFormat=N1}" />
                        <GridViewColumn Header="ROI %" Width="65" DisplayMemberBinding="{Binding Candidate.RoiPercent, StringFormat=N1}" />
                        <GridViewColumn Header="Sold / day" Width="80" DisplayMemberBinding="{Binding Candidate.DailyVolume, StringFormat=N1}" />
                        <GridViewColumn Header="Max crafts" Width="80" DisplayMemberBinding="{Binding MaxCrafts}" />
                        <GridViewColumn Header="Planned" Width="70" DisplayMemberBinding="{Binding PlannedCrafts}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</UserControl>
